<Project Sdk="Microsoft.NET.Sdk">

  <!-- UI Automation through COM is not trim/AOT safe (like the Anthropic SDK, see ADR-0001), so this project is not marked IsAotCompatible. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Interop.UIAutomationClient" Version="10.19041.0" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kairo.Core\Kairo.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kairo.Core.Tests" />
  </ItemGroup>

</Project>
