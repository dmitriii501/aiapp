<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Kairo.Desktop</RootNamespace>
    <AssemblyName>Kairo</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Kairo.ico</ApplicationIcon>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged, self-contained Windows App SDK: no MSIX and no separate runtime install (installer choice: OPEN-QUESTIONS #1). -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' And '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <UiDir>$(MSBuildThisFileDirectory)..\..\ui\</UiDir>
    <!-- Own Main (Program.cs): Velopack must run before the XAML app starts. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- Release builds pass -p:KairoUpdateUrl=https://github.com/OWNER/REPO; local builds have no feed. -->
    <KairoUpdateUrl Condition="'$(KairoUpdateUrl)' == ''"></KairoUpdateUrl>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>KairoUpdateUrl</_Parameter1>
      <_Parameter2>$(KairoUpdateUrl)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- The window and taskbar icon is set at run time from this file (the exe's own icon is embedded by ApplicationIcon). -->
  <ItemGroup>
    <Content Include="Assets/Kairo.ico" Link="Kairo.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kairo.Host\Kairo.Host.csproj" />
    <ProjectReference Include="..\Kairo.Windows\Kairo.Windows.csproj" />
    <ProjectReference Include="..\Kairo.PcControl\Kairo.PcControl.csproj" />
  </ItemGroup>

  <!--
    An unpackaged WinUI app cannot start without its compiled XAML (App.xbf, MainWindow.xbf) and resource index (Kairo.pri), and
    "dotnet publish" leaves them out of the publish folder. Add them from the build output.
  -->
  <Target Name="KairoPublishXaml" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_KairoXaml Include="$(OutDir)App.xbf;$(OutDir)MainWindow.xbf;$(OutDir)$(AssemblyName).pri" />
      <ResolvedFileToPublish Include="@(_KairoXaml)" Condition="Exists('%(FullPath)')">
        <RelativePath>%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <!-- Rebuilds ui/ when its sources change and ships ui/dist next to the exe as "ui\". Set KairoSkipUi=true to skip. -->
  <ItemGroup>
    <KairoUiSource Include="$(UiDir)src\**\*;$(UiDir)index.html;$(UiDir)package.json;$(UiDir)vite.config.ts" />
  </ItemGroup>

  <Target Name="KairoBuildUi" Inputs="@(KairoUiSource)" Outputs="$(UiDir)dist\index.html" Condition="'$(KairoSkipUi)' != 'true'">
    <Exec Condition="!Exists('$(UiDir)node_modules')" Command="npm ci" WorkingDirectory="$(UiDir)" />
    <Exec Command="npm run build" WorkingDirectory="$(UiDir)" />
  </Target>

  <Target Name="KairoIncludeUi" DependsOnTargets="KairoBuildUi" BeforeTargets="AssignTargetPaths" Condition="'$(KairoSkipUi)' != 'true'">
    <ItemGroup>
      <_KairoUiFile Include="$(UiDir)dist\**\*" />
      <Content Include="@(_KairoUiFile)">
        <Link>ui\%(_KairoUiFile.RecursiveDir)%(_KairoUiFile.Filename)%(_KairoUiFile.Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>
  </Target>

</Project>
