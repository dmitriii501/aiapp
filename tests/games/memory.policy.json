{
  "goal": "Memory game: find all six pairs of the twelve cards, remembering which symbol is on which card",
  "app": "msedge.exe",
  "width": 1024,
  "see": {
    "find": {
      "tl": { "look": "the card in the top-left corner of the grid of twelve cards", "presence": false },
      "br": { "look": "the card in the bottom-right corner of the grid of twelve cards", "presence": false }
    },
    "check": { "over": "the text All pairs found is shown" },
    "choose": {
      "symbol": {
        "question": "Which symbol is shown on the card that has the yellow outline? Answer none when no card has a yellow outline.",
        "options": {
          "star": "a star",
          "circle": "a filled circle",
          "triangle": "a triangle",
          "square": "a square",
          "heart": "a heart",
          "diamond": "a diamond",
          "none": "no card has a yellow outline"
        }
      }
    }
  },
  "vars": { "cols": 4, "rows": 3, "known": {}, "done": {}, "phase": 0, "first": -1, "second": -1, "a": -1, "b": -1, "t": -1 },
  "rules": [
    { "name": "end", "when": "check.over > 0.8", "do": [ { "stop": "all pairs found" } ] },

    { "name": "read_first_match",
      "when": "phase == 1 && choose.symbol != 'none' && find.tl.conf > 0.4 && find.br.conf > 0.4 && find_key(known, choose.symbol, done, first) >= 0",
      "do": [
        { "put": { "map": "known", "key": "first", "value": "choose.symbol" } },
        { "set": "t = find_key(known, choose.symbol, done, first)" },
        { "click": { "x": "find.tl.x + (t % cols) * (find.br.x - find.tl.x) / (cols - 1)", "y": "find.tl.y + floor(t / cols) * (find.br.y - find.tl.y) / (rows - 1)" } },
        { "put": { "map": "done", "key": "first", "value": "1" } },
        { "put": { "map": "done", "key": "t", "value": "1" } },
        { "set": "phase = 0" },
        { "wait": 300 }
      ] },
    { "name": "read_first_new",
      "when": "phase == 1 && choose.symbol != 'none' && find.tl.conf > 0.4 && find.br.conf > 0.4",
      "do": [
        { "put": { "map": "known", "key": "first", "value": "choose.symbol" } },
        { "set": "second = first_free(known, 12)" },
        { "set": "t = second" },
        { "click": { "x": "find.tl.x + (t % cols) * (find.br.x - find.tl.x) / (cols - 1)", "y": "find.tl.y + floor(t / cols) * (find.br.y - find.tl.y) / (rows - 1)" } },
        { "set": "phase = 2" },
        { "wait": 300 }
      ] },
    { "name": "read_second_match",
      "when": "phase == 2 && choose.symbol != 'none' && choose.symbol == get(known, first)",
      "do": [
        { "put": { "map": "known", "key": "second", "value": "choose.symbol" } },
        { "put": { "map": "done", "key": "first", "value": "1" } },
        { "put": { "map": "done", "key": "second", "value": "1" } },
        { "set": "phase = 0" },
        { "wait": 300 }
      ] },
    { "name": "read_second_miss",
      "when": "phase == 2 && choose.symbol != 'none'",
      "do": [
        { "put": { "map": "known", "key": "second", "value": "choose.symbol" } },
        { "set": "phase = 0" },
        { "wait": 1000 }
      ] },

    { "name": "second_of_known_pair",
      "when": "phase == 3 && find.tl.conf > 0.4 && find.br.conf > 0.4",
      "do": [
        { "set": "t = b" },
        { "click": { "x": "find.tl.x + (t % cols) * (find.br.x - find.tl.x) / (cols - 1)", "y": "find.tl.y + floor(t / cols) * (find.br.y - find.tl.y) / (rows - 1)" } },
        { "put": { "map": "done", "key": "a", "value": "1" } },
        { "put": { "map": "done", "key": "b", "value": "1" } },
        { "set": "phase = 0" },
        { "wait": 300 }
      ] },
    { "name": "first_of_known_pair",
      "when": "phase == 0 && pair_a(known, done) >= 0 && find.tl.conf > 0.4 && find.br.conf > 0.4",
      "do": [
        { "set": "a = pair_a(known, done)" },
        { "set": "b = pair_b(known, done)" },
        { "set": "t = a" },
        { "click": { "x": "find.tl.x + (t % cols) * (find.br.x - find.tl.x) / (cols - 1)", "y": "find.tl.y + floor(t / cols) * (find.br.y - find.tl.y) / (rows - 1)" } },
        { "set": "phase = 3" },
        { "wait": 200 }
      ] },
    { "name": "open_unknown",
      "when": "phase == 0 && first_free(known, 12) >= 0 && find.tl.conf > 0.4 && find.br.conf > 0.4",
      "do": [
        { "set": "first = first_free(known, 12)" },
        { "set": "t = first" },
        { "click": { "x": "find.tl.x + (t % cols) * (find.br.x - find.tl.x) / (cols - 1)", "y": "find.tl.y + floor(t / cols) * (find.br.y - find.tl.y) / (rows - 1)" } },
        { "set": "phase = 1" },
        { "wait": 300 }
      ] }
  ],
  "limits": { "max_seconds": 120, "stall_ticks": 10 }
}
